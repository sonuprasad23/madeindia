# Rakshak — example environment configuration.
#
# This is a DEMO application. Nothing here is a production secret, and no
# value below should ever be a real credential. Copy this file to `.env`
# for local reference only — Flutter does not read `.env` files directly;
# these are passed to the app via `--dart-define` at build/run time, e.g.:
#
#   flutter run --dart-define=ADMIN_DEMO_USERNAME=admin --dart-define=ADMIN_DEMO_PASSWORD=Rakshak@Demo123
#
# In Codemagic, set the same keys as encrypted environment variables in the
# workflow's environment group instead of committing a real `.env` file.

# --- Admin demo login (see lib/admin/auth/demo_admin_credentials.dart) ---
ADMIN_DEMO_USERNAME=admin
ADMIN_DEMO_PASSWORD=Rakshak@Demo123

# --- Reserved for future real integrations (all OFF / unused today) ---
# Real threat-intelligence feed API base URL (feature flag currently OFF).
# THREAT_INTEL_API_BASE_URL=

# Real government complaint-submission API base URL (feature flag OFF —
# see AppConstants.demoDisclaimer; this demo never submits real complaints).
# GOVERNMENT_API_BASE_URL=

# DigiLocker OAuth client id (feature flag OFF — no real DigiLocker
# integration exists in this codebase yet).
# DIGILOCKER_CLIENT_ID=
